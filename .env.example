# Copy to .env (scripts/pre-setup.sh does this and fills the generated secrets).
# Keep .env out of Git and readable only by you: chmod 600 .env

# ---- General ---------------------------------------------------------------
TZ=Asia/Kolkata

# ---- Image versions ----------------------------------------------------------
# n8n and n8nio/runners must use the same version.
N8N_VERSION=2.45.4
OLLAMA_VERSION=latest
SEARXNG_VERSION=latest

# ---- n8n ---------------------------------------------------------------------
# Hostname or IP of this server, as you type it in the browser.
N8N_HOST=<server-ip-or-hostname>
N8N_PROTOCOL=http
# Full URL you open n8n with. LinkedIn redirects back here after OAuth, so it
# must match the browser URL exactly (no trailing slash).
N8N_PUBLIC_URL=http://<server-ip-or-hostname>:5678

# Generated by pre-setup.sh. BACK THIS UP: if it is lost or changed, every
# credential stored in n8n becomes unreadable.
N8N_ENCRYPTION_KEY=<generated>
# Shared by n8n and n8n-runners. Generated by pre-setup.sh.
N8N_RUNNERS_AUTH_TOKEN=<generated>

# ---- Ollama models -----------------------------------------------------------
# Models pulled by scripts/post-setup.sh. Must match the model nodes in the workflow.
OLLAMA_MODELS="gemma4:e2b phi4-mini:latest qwen2.5:1.5b"

# ---- Optional: SearXNG (docker compose --profile search up -d) ------------------
# Generated by pre-setup.sh.
SEARXNG_SECRET=<generated>

# ---- Optional: n8n Sandbox (docker compose --profile sandbox up -d) -------------
# Not used by the LinkedIn workflow. Uncomment and fill only if you enable the
# sandbox profile. Generate each value with: openssl rand -hex 32
# Pairs on the same line group must hold the same value.
#
# SANDBOX_API_KEYS=
# N8N_SANDBOX_SERVICE_API_KEY=                 (same as SANDBOX_API_KEYS)
# SANDBOX_API_RUNNER_REGISTRATION_TOKEN=
# SANDBOX_RUNNER_REGISTRATION_TOKEN=           (same as SANDBOX_API_RUNNER_REGISTRATION_TOKEN)
# SANDBOX_API_RUNNER_API_KEY=
# SANDBOX_RUNNER_API_KEYS=                     (same as SANDBOX_API_RUNNER_API_KEY)
